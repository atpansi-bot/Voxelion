<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Voxelion.Android</RootNamespace>
    <AssemblyName>Voxelion.Android</AssemblyName>
    <ApplicationTitle>VOXELION</ApplicationTitle>
    <ApplicationId>com.voxelion.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <UseInterpreter>false</UseInterpreter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.2.1105" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Voxelion.Core\Voxelion.Core.csproj" />
  </ItemGroup>

  <!-- Explicitly exclude any leftover Hello Android layouts if present -->
  <ItemGroup>
    <AndroidResource Remove="**/activity_main.xml" />
    <AndroidResource Remove="**/MainPage.*" />
  </ItemGroup>
</Project>
